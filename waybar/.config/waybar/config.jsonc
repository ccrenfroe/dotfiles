// -*- mode: jsonc -*-
{
    "name": "main",
    "output": "DP-1",
    "layer": "top", // Waybar at top layer
    "opacity": "0.8",
    "position": "top", // Waybar position (top|bottom|left|right)
    "width": 1740, // Waybar width
    "spacing": 0, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
	"hyprland/workspaces"
    ],
    "modules-center": [
        "custom/media"
    ],
    "modules-right": [
        "cpu",
        "memory",
	"disk",
        "clock"
    ],
    "tray": {
        "icon-size": 10,
        "spacing": 10
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": true
    },
    "disk": {
        "format": "{percentage_free}% ",
	"tooltip": true
    },
    "memory": {
        "format": "{}% ",
	"tooltip": true
    },
    "clock": {
        "timezone": "America/New_York",
	"format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "hyprland/workspaces": {
	"format": "{icon}",
	"format-icons": {
	"active": "",
	"default": "",
	"visible": "",
	"5": "|"
	},
	"all-outputs": true,
        "active-only": false,
	"persistent-only": true // use this to read the rules from hyprland.conf
    },
   "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "format-icons": {
            "spotify": "",
	    "ncspot": "",
            "default": ""
        },
        "escape": true,
        "exec": "python $HOME/.config/waybar/scripts/mediaplayer.py --exclude firefox 2> /dev/null" // Filter player based on name
    }
}
